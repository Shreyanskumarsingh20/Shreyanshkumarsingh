# Copy to .env.local for local work; set the same names in Vercel → Settings →
# Environment Variables (Production) for the live site.

# Telegram bot 1 — every alert (crawlers, AI agents, MCP clients, all visits)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram bot 2 — real human visits and hot actions only
TELEGRAM_HUMAN_BOT_TOKEN=
TELEGRAM_HUMAN_CHAT_ID=
# 1 = let localhost traffic send alerts too (off by default)
NEXT_PUBLIC_BEACON_DEBUG=

# Optional: override the canonical origin (defaults to the www domain)
NEXT_PUBLIC_SITE_URL=
